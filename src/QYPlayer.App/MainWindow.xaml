<ui:FluentWindow x:Class="QYPlayer.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:models="clr-namespace:QYPlayer.Core.Models;assembly=QYPlayer.Core"
                 mc:Ignorable="d"
                 Title="QY Player"
                 Height="700" Width="1120"
                 MinHeight="560" MinWidth="900"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 AllowDrop="True"
                 Loaded="OnWindowLoaded"
                 DragOver="OnWindowDragOver"
                 Drop="OnWindowDrop">
    <!--
      窗口本身不再写死 Background / Foreground：
      FluentWindow 的默认样式已把它们绑到 WindowBackground / WindowForeground 两个
      动态资源上，主题切换时自动跟随。写死字面量会在切到浅色时留下一条深色底。
    -->

    <!--
      从 M2-4 起界面分成左右两栏：左侧是曲库（搜索 + 列表 + 文件夹管理），
      右侧是当前曲目的播放区。这样「挑歌」与「放歌」在视觉上各占一边，
      列表再长也不会把播放控件挤出视野。
    -->

    <ui:FluentWindow.Resources>

        <!-- 空态提示、扫描进度条的可见性都靠布尔取反/转换，这里备好两个转换器。 -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--
          传输控制按钮：圆形底盘 + 悬停/按下反馈。
          颜色全部改用主题资源键，深色/浅色各自取值，不再写死字面量。
        -->
        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Plate" Fill="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Fill"
                                        Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Plate" Property="Fill"
                                        Value="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主播放键：实心强调色，视觉上作为整个界面的焦点。 -->
        <Style x:Key="PrimaryTransportButton" TargetType="Button" BasedOn="{StaticResource TransportButton}">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Plate" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Fill"
                                        Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Plate" Property="Fill"
                                        Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          ===== 滑动条（进度条 / 音量条）共用外观 =====

          WPF UI 自带的 Slider 模板把「已播放 / 已到达」那一段对应的
          DecreaseRepeatButton 画成了一个完全透明的 Button，
          于是整条轨道从头到尾都是同一种灰色，看不出播放进度。
          下面这套模板把它改成强调色，这就是「已播放部分显示为蓝色」的落点。

          为什么不用 AccentFillColorDefaultBrush：这个键在深色主题下取到的是
          #FF003E92（很深的蓝），压在同为深色的轨道上几乎看不出边界，
          与「一眼分辨播没播过」的诉求相悖。这里直接取系统强调色的主色调，
          亮度足够，浅色主题下也依然清晰。
        -->

        <!-- 已播放侧的蓝色。单独抽成资源，方便一处调色、两条滑块同时生效。 -->
        <SolidColorBrush x:Key="PlayerSliderPlayedBrush"
                         Color="{DynamicResource SystemAccentColorPrimary}" />

        <!--
          为什么整段重写模板而不是只替换某个子样式：
          Track 会把 DecreaseRepeatButton 的右边缘钉在 Thumb 上，
          因此它的宽度天然就等于已播放的长度，正是我们要着色的那一段；
          但它的外观来自模板内部用 StaticResource 指定的样式，
          外部没有替换的入口，只能自备一份模板。
          模板其余部分尽量与上游保持一致（轨道 4px、Thumb 20px 圆点），
          只把已播放侧换成强调色，并补上禁用时的整条淡化。
        -->

        <!-- 未播放侧：保持透明，让底层的灰色轨道透出来。 -->
        <Style x:Key="PlayerSliderTransparentSide" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 已播放侧：蓝色，宽度由 Track 自动算成「轨道左端到 Thumb」。 -->
        <Style x:Key="PlayerSliderPlayedSide" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <!--
                          高度与圆角跟下面的底层轨道对齐，视觉上才是同一条线，
                          不能让它撑满 Track 给的高度，否则会盖住整个滑块。
                        -->
                        <Border Height="4"
                                VerticalAlignment="Center"
                                CornerRadius="2"
                                Background="{DynamicResource PlayerSliderPlayedBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 滑块圆点：取值沿用 WPF UI，保证与其它控件观感一致。 -->
        <Style x:Key="PlayerSliderThumb" TargetType="Thumb">
            <Setter Property="Height" Value="20" />
            <Setter Property="Width" Value="20" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SliderThumbBackground}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource SliderOuterThumbBackground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <Ellipse Width="12" Height="12"
                                     Fill="{TemplateBinding Foreground}"
                                     Stroke="Transparent"
                                     StrokeThickness="0" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          水平模板：底层灰色轨道 + Track（已播放侧着色）+ Thumb。
          刻度条（TickBar）省略：本项目不显示刻度，TickPlacement 保持默认 None，
          上游模板里那两条刻度也一直是 Collapsed。

          中间那一行的 MinHeight 必须留着：它把 Track 所在行撑到控件的最小高度，
          Thumb（20px）才有地方落座；去掉之后轨道会被压扁成 4px，滑块看不见。
        -->
        <ControlTemplate x:Key="PlayerSliderTemplate" TargetType="Slider">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="TrackBackground"
                        Grid.Row="1"
                        Height="4"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SliderTrackFill}"
                        BorderThickness="0"
                        CornerRadius="2" />
                <Track x:Name="PART_Track" Grid.Row="1">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="Slider.DecreaseLarge"
                                      Style="{StaticResource PlayerSliderPlayedSide}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource PlayerSliderThumb}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="Slider.IncreaseLarge"
                                      Style="{StaticResource PlayerSliderTransparentSide}" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="TrackBackground" Property="Background"
                            Value="{DynamicResource SliderTrackFillPointerOver}" />
                    <Setter TargetName="TrackBackground" Property="Opacity" Value="0.6" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="PlayerSliderStyle" TargetType="Slider">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Template" Value="{StaticResource PlayerSliderTemplate}" />
            <Style.Triggers>
                <!-- 没有曲目时整条淡化，让「不能拖」这件事看得出来。 -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--
          ===== 曲库列表 =====

          列表项自备模板而不是套用 WPF UI 的 ListBoxItem 样式：
          需要「整行铺满、悬停变浅、选中加深、四角圆润」，而默认样式给了
          一圈选中边框与内边距，行与行之间看起来会断开，不像一张连续的清单。
          这里用主题资源键取色，深浅两种主题下都能自动适配。

          为什么在模板里只改背景而不动内容布局：
          ContentPresenter 必须保留，否则 ItemTemplate 渲染不出来（列表会全空）。
        -->
        <Style x:Key="TrackItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Plate"
                                CornerRadius="6"
                                Padding="10,5"
                                Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Plate" Property="Background"
                                        Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </ui:FluentWindow.Resources>

    <ui:FluentWindow.InputBindings>
        <!-- 空格切换播放/暂停，Ctrl+O 打开文件，符合桌面播放器的既有习惯。 -->
        <KeyBinding Key="Space" Command="{Binding TogglePlayPauseCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding StopCommand}" />
        <KeyBinding Key="M" Modifiers="Control" Command="{Binding ToggleMuteCommand}" />
        <!-- 切歌用 Ctrl 组合而不是裸方向键：裸方向键要留给列表里的上下选择。 -->
        <KeyBinding Key="Right" Modifiers="Control" Command="{Binding PlayNextCommand}" />
        <KeyBinding Key="Left" Modifiers="Control" Command="{Binding PlayPreviousCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding CycleRepeatModeCommand}" />
    </ui:FluentWindow.InputBindings>

    <!--
      根容器用 Grid 分两行：第 0 行是 WPF UI 的标题栏，第 1 行是原内容。
      标题栏必须留在窗口模板的客户区内，否则沉浸式标题栏没有按钮可点。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
          标题栏：应用名 + 居中的当前状态 + 右侧三个窗口按钮。
          Title 走 Header，状态走 CenterContent。

          这里必须显式指定 HorizontalContentAlignment：TitleBar 的模板把
          CenterContent 的 HorizontalAlignment 绑到 HorizontalContentAlignment 上，
          而该属性继承自 Control 的默认值 Left，且 TitleBar 的样式没有覆盖它。
          不写的话状态文字会贴着左侧的应用名，看起来像是错位。
          VerticalContentAlignment 方面，样式给的默认值是 Stretch，
          因此 TextBlock 还要自己居中，否则文字会顶在标题栏上沿。

          另需注意：Header 与 CenterContent 都是纯文本，不参与拖动窗口，
          只有标题栏空白处可以拖动。
        -->
        <ui:TitleBar Grid.Row="0"
                     Title="QY Player"
                     Icon="{ui:SymbolIcon MusicNote224}"
                     HorizontalContentAlignment="Center">
            <ui:TitleBar.CenterContent>
                <TextBlock Text="{Binding StatusText}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="420" />
            </ui:TitleBar.CenterContent>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="20,14,20,20">
            <Grid.ColumnDefinitions>
                <!-- 左侧曲库固定宽度：列表是「扫读」用的，宽度稳定比自适应更好用。 -->
                <ColumnDefinition Width="340" MinWidth="260" />
                <ColumnDefinition Width="*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- ===================== 左栏：曲库 ===================== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 栏头：标题 + 两个入口按钮 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="曲库"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <ui:Button Grid.Column="1"
                               Content="打开文件"
                               Icon="{ui:SymbolIcon FolderOpen24}"
                               Command="{Binding OpenFileCommand}"
                               ToolTip="打开单个音频文件播放 (Ctrl+O)" />

                    <ui:Button Grid.Column="2"
                               Margin="8,0,0,0"
                               Content="添加文件夹"
                               Appearance="Primary"
                               Command="{Binding AddLibraryFolderCommand}"
                               ToolTip="把音乐文件夹加入曲库，之后启动会自动同步" />
                </Grid>

                <!-- 搜索框：输入即过滤，没有「回车才生效」这一步 -->
                <ui:TextBox x:Name="SearchBox"
                            Grid.Row="1"
                            Margin="0,12,0,0"
                            PlaceholderText="搜索标题、艺术家、专辑或文件名"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <!--
                  曲库列表。
                  虚拟化必须显式打开：曲库是「几千到几万条」，不虚拟化时
                  WPF 会为每一首建一个容器，扫描完成后界面会明显卡住。
                  Recycling 模式复用容器，滚动时不再反复创建销毁。
                -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <ListView x:Name="TrackList"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="0"
                              ItemsSource="{Binding VisibleTracks}"
                              ItemContainerStyle="{StaticResource TrackItemStyle}"
                              SelectedIndex="{Binding CurrentIndex, Mode=OneWay}"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              MouseDoubleClick="OnTrackListDoubleClick">
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Track}">
                                <Grid Height="42">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding DisplayArtist}"
                                                   FontSize="11"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DurationText}"
                                               FontSize="11"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!--
                      空态提示压在列表之上。
                      两种情形分开写文案：曲库真的一首都没有时给「去添加文件夹」的引导，
                      而搜索没结果时提醒是关键词的问题，别让用户误以为曲库被清空了。
                    -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="{Binding IsLibraryEmpty, Converter={StaticResource BoolToVisibility}}">
                        <ui:SymbolIcon Symbol="MusicNote224"
                                       FontSize="34"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorDisabledBrush}" />
                        <TextBlock Text="曲库还是空的"
                                   Margin="0,10,0,0"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="点上方「添加文件夹」，或把音频文件直接拖进窗口"
                                   Margin="0,6,0,0"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <TextBlock Text="没有匹配的曲目"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="13"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <!-- 列表页脚：扫描进度 / 命中数量 -->
                <TextBlock Grid.Row="3"
                           Margin="2,8,0,0"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="{Binding ScanProgressText, TargetNullValue='双击列表中的曲目即可播放'}" />
            </Grid>

            <!-- ===================== 右栏：播放区 ===================== -->
            <Grid Grid.Column="1" Margin="28,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 中部：封面 + 曲目信息 -->
                <Grid Grid.Row="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--
                      封面容器。未提取到封面时底层的音符占位图标会透出来，
                      因此不需要额外的可见性切换逻辑。
                    -->
                    <Border Grid.Column="0" Width="180" Height="180" CornerRadius="10"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            ClipToBounds="True">
                        <Grid>
                            <ui:SymbolIcon Symbol="MusicNote224" FontSize="46"
                                           Foreground="{DynamicResource TextFillColorDisabledBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding CurrentTrack.CoverCachePath}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="26,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Artist}" FontSize="16" Margin="0,10,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Album}" FontSize="13" Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding FormatText}" FontSize="12" Margin="0,14,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!-- 进度条与时间 -->
                <Grid Grid.Row="1" Margin="0,30,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding PositionText}" FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" MinWidth="48" />

                    <!--
                      进度条：外观走上面自备的 PlayerSliderStyle（已播放段为蓝色）。
                      单击跳转不走 XAML 事件，原因见 MainWindow.xaml.cs 里的
                      OnSeekMouseLeftButtonDown：必须赶在引擎旧位置回包覆盖之前提交，
                      而且要绕过 Slider 自己对该事件的 Handled 标记。
                    -->
                    <Slider x:Name="SeekSlider" Grid.Column="1" Margin="12,0,12,0"
                            Style="{StaticResource PlayerSliderStyle}"
                            Minimum="0"
                            Maximum="{Binding DurationSeconds}"
                            Value="{Binding PositionSeconds, Mode=TwoWay}"
                            IsEnabled="{Binding HasMedia}"
                            IsMoveToPointEnabled="True"
                            Cursor="Hand"
                            PreviewKeyUp="OnSeekKeyUp"
                            Thumb.DragStarted="OnSeekDragStarted"
                            Thumb.DragCompleted="OnSeekDragCompleted" />

                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" MinWidth="48"
                               TextAlignment="Right" />
                </Grid>

                <!-- 传输控制与音量 -->
                <Grid Grid.Row="2" Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--
                      左侧：停止 + 播放模式。
                      播放模式放在这里而不是挨着主播放键：它不是「切歌」动作，
                      而是对切歌行为的设置，跟停止一起归到「其它操作」更清楚。
                    -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource TransportButton}"
                                Command="{Binding StopCommand}"
                                IsEnabled="{Binding HasMedia}"
                                ToolTip="停止 (Ctrl+S)">
                            <ui:SymbolIcon Symbol="Stop24" FontSize="14" />
                        </Button>

                        <Button Style="{StaticResource TransportButton}" Margin="10,0,0,0"
                                Command="{Binding CycleRepeatModeCommand}"
                                ToolTip="{Binding RepeatHint}">
                            <ui:SymbolIcon Symbol="{Binding RepeatSymbol}" FontSize="16" />
                        </Button>
                    </StackPanel>

                    <!--
                      中间：上一首 / 播放暂停 / 下一首。
                      上一首与下一首在只有一首歌或队列为空时仍然可用（会重播自己），
                      因此只用 HasMedia 决定是否启用，避免用户对着灰按钮猜为什么点不动。
                    -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource TransportButton}"
                                Command="{Binding PlayPreviousCommand}"
                                ToolTip="上一首 (Ctrl+←)">
                            <ui:SymbolIcon Symbol="ArrowPrevious24" FontSize="16" />
                        </Button>

                        <Button Style="{StaticResource PrimaryTransportButton}" Margin="14,0,0,0"
                                Command="{Binding TogglePlayPauseCommand}"
                                IsEnabled="{Binding HasMedia}"
                                ToolTip="{Binding PlayPauseHint}">
                            <!--
                              图标交给 ViewModel 决定：这里不能再用「本地 Text 值 + 样式触发器」，
                              因为本地值的优先级高于触发器，触发器永远不生效，图标会恒定不变。
                            -->
                            <ui:SymbolIcon Symbol="{Binding PlayPauseSymbol}" FontSize="22" />
                        </Button>

                        <Button Style="{StaticResource TransportButton}" Margin="14,0,0,0"
                                Command="{Binding PlayNextCommand}"
                                ToolTip="下一首 (Ctrl+→)">
                            <ui:SymbolIcon Symbol="ArrowNext24" FontSize="16" />
                        </Button>
                    </StackPanel>

                    <!--
                      静音键与音量滑块合为一组：喇叭图标既显示当前状态、又是静音开关，
                      滑块紧随其后调节音量。

                      与进度条同款外观（已到达一段为蓝色），同样开启单击定位。
                      音量走的是 OnVolumeChanged 直接写回引擎，不需要额外提交，
                      因此这里不需要事件处理器。
                    -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource TransportButton}"
                                Command="{Binding ToggleMuteCommand}"
                                ToolTip="{Binding VolumeText}">
                            <ui:SymbolIcon Symbol="{Binding VolumeSymbol}" FontSize="16" />
                        </Button>

                        <Slider Width="130" Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource PlayerSliderStyle}"
                                Minimum="0" Maximum="100"
                                Value="{Binding Volume, Mode=TwoWay}"
                                IsMoveToPointEnabled="True"
                                Cursor="Hand"
                                ToolTip="{Binding VolumeText}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
