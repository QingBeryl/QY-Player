<ui:FluentWindow x:Class="QYPlayer.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title="QY Player"
                 Height="560" Width="900"
                 MinHeight="480" MinWidth="720"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 AllowDrop="True"
                 Loaded="OnWindowLoaded"
                 DragOver="OnWindowDragOver"
                 Drop="OnWindowDrop">
    <!--
      窗口本身不再写死 Background / Foreground：
      FluentWindow 的默认样式已把它们绑到 WindowBackground / WindowForeground 两个
      动态资源上，主题切换时自动跟随。写死字面量会在切到浅色时留下一条深色底。
    -->

    <!--
      M1 阶段的界面只覆盖「单文件播放」这一条主线：
      打开文件、元数据展示、播放控制、进度与音量。
      曲库列表、播放队列、歌词在 M2 / M2.5 再补，避免过早把布局写死。
    -->

    <ui:FluentWindow.Resources>

        <!--
          传输控制按钮：圆形底盘 + 悬停/按下反馈。
          颜色全部改用主题资源键，深色/浅色各自取值，不再写死字面量。
        -->
        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Plate" Fill="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Fill"
                                        Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Plate" Property="Fill"
                                        Value="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主播放键：实心强调色，视觉上作为整个界面的焦点。 -->
        <Style x:Key="PrimaryTransportButton" TargetType="Button" BasedOn="{StaticResource TransportButton}">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Plate" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Fill"
                                        Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Plate" Property="Fill"
                                        Value="{DynamicResource AccentFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          ===== 滑动条（进度条 / 音量条）共用外观 =====

          WPF UI 自带的 Slider 模板把「已播放 / 已到达」那一段对应的
          DecreaseRepeatButton 画成了一个完全透明的 Button，
          于是整条轨道从头到尾都是同一种灰色，看不出播放进度。
          下面这套模板把它改成强调色，这就是「已播放部分显示为蓝色」的落点。

          为什么不用 AccentFillColorDefaultBrush：这个键在深色主题下取到的是
          #FF003E92（很深的蓝），压在同为深色的轨道上几乎看不出边界，
          与「一眼分辨播没播过」的诉求相悖。这里直接取系统强调色的主色调，
          亮度足够，浅色主题下也依然清晰。
        -->

        <!-- 已播放侧的蓝色。单独抽成资源，方便一处调色、两条滑块同时生效。 -->
        <SolidColorBrush x:Key="PlayerSliderPlayedBrush"
                         Color="{DynamicResource SystemAccentColorPrimary}" />

        <!--
          为什么整段重写模板而不是只替换某个子样式：
          Track 会把 DecreaseRepeatButton 的右边缘钉在 Thumb 上，
          因此它的宽度天然就等于已播放的长度，正是我们要着色的那一段；
          但它的外观来自模板内部用 StaticResource 指定的样式，
          外部没有替换的入口，只能自备一份模板。
          模板其余部分尽量与上游保持一致（轨道 4px、Thumb 20px 圆点），
          只把已播放侧换成强调色，并补上禁用时的整条淡化。
        -->

        <!-- 未播放侧：保持透明，让底层的灰色轨道透出来。 -->
        <Style x:Key="PlayerSliderTransparentSide" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 已播放侧：蓝色，宽度由 Track 自动算成「轨道左端到 Thumb」。 -->
        <Style x:Key="PlayerSliderPlayedSide" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <!--
                          高度与圆角跟下面的底层轨道对齐，视觉上才是同一条线，
                          不能让它撑满 Track 给的高度，否则会盖住整个滑块。
                        -->
                        <Border Height="4"
                                VerticalAlignment="Center"
                                CornerRadius="2"
                                Background="{DynamicResource PlayerSliderPlayedBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 滑块圆点：取值沿用 WPF UI，保证与其它控件观感一致。 -->
        <Style x:Key="PlayerSliderThumb" TargetType="Thumb">
            <Setter Property="Height" Value="20" />
            <Setter Property="Width" Value="20" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SliderThumbBackground}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource SliderOuterThumbBackground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <Ellipse Width="12" Height="12"
                                     Fill="{TemplateBinding Foreground}"
                                     Stroke="Transparent"
                                     StrokeThickness="0" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          水平模板：底层灰色轨道 + Track（已播放侧着色）+ Thumb。
          刻度条（TickBar）省略：本项目不显示刻度，TickPlacement 保持默认 None，
          上游模板里那两条刻度也一直是 Collapsed。

          中间那一行的 MinHeight 必须留着：它把 Track 所在行撑到控件的最小高度，
          Thumb（20px）才有地方落座；去掉之后轨道会被压扁成 4px，滑块看不见。
        -->
        <ControlTemplate x:Key="PlayerSliderTemplate" TargetType="Slider">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="TrackBackground"
                        Grid.Row="1"
                        Height="4"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SliderTrackFill}"
                        BorderThickness="0"
                        CornerRadius="2" />
                <Track x:Name="PART_Track" Grid.Row="1">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="Slider.DecreaseLarge"
                                      Style="{StaticResource PlayerSliderPlayedSide}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource PlayerSliderThumb}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="Slider.IncreaseLarge"
                                      Style="{StaticResource PlayerSliderTransparentSide}" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="TrackBackground" Property="Background"
                            Value="{DynamicResource SliderTrackFillPointerOver}" />
                    <Setter TargetName="TrackBackground" Property="Opacity" Value="0.6" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="PlayerSliderStyle" TargetType="Slider">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Template" Value="{StaticResource PlayerSliderTemplate}" />
            <Style.Triggers>
                <!-- 没有曲目时整条淡化，让「不能拖」这件事看得出来。 -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </ui:FluentWindow.Resources>

    <ui:FluentWindow.InputBindings>
        <!-- 空格切换播放/暂停，Ctrl+O 打开文件，符合桌面播放器的既有习惯。 -->
        <KeyBinding Key="Space" Command="{Binding TogglePlayPauseCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding StopCommand}" />
        <KeyBinding Key="M" Modifiers="Control" Command="{Binding ToggleMuteCommand}" />
    </ui:FluentWindow.InputBindings>

    <!--
      根容器用 Grid 分两行：第 0 行是 WPF UI 的标题栏，第 1 行是原内容。
      标题栏必须留在窗口模板的客户区内，否则沉浸式标题栏没有按钮可点。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
          标题栏：应用名 + 居中的当前状态 + 右侧三个窗口按钮。
          Title 走 Header，状态走 CenterContent。

          这里必须显式指定 HorizontalContentAlignment：TitleBar 的模板把
          CenterContent 的 HorizontalAlignment 绑到 HorizontalContentAlignment 上，
          而该属性继承自 Control 的默认值 Left，且 TitleBar 的样式没有覆盖它。
          不写的话状态文字会贴着左侧的应用名，看起来像是错位。
          VerticalContentAlignment 方面，样式给的默认值是 Stretch，
          因此 TextBlock 还要自己居中，否则文字会顶在标题栏上沿。

          另需注意：Header 与 CenterContent 都是纯文本，不参与拖动窗口，
          只有标题栏空白处可以拖动。
        -->
        <ui:TitleBar Grid.Row="0"
                     Title="QY Player"
                     Icon="{ui:SymbolIcon MusicNote224}"
                     HorizontalContentAlignment="Center">
            <ui:TitleBar.CenterContent>
                <TextBlock Text="{Binding StatusText}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="420" />
            </ui:TitleBar.CenterContent>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="28,16,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 中部：封面 + 曲目信息 -->
            <Grid Grid.Row="0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--
                  封面容器。未提取到封面时底层的音符占位图标会透出来，
                  因此不需要额外的可见性切换逻辑。
                -->
                <Border Grid.Column="0" Width="180" Height="180" CornerRadius="10"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        ClipToBounds="True">
                    <Grid>
                        <ui:SymbolIcon Symbol="MusicNote224" FontSize="46"
                                       Foreground="{DynamicResource TextFillColorDisabledBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding CurrentTrack.CoverCachePath}" Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="26,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Artist}" FontSize="16" Margin="0,10,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Album}" FontSize="13" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding FormatText}" FontSize="12" Margin="0,14,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <!-- 进度条与时间 -->
            <Grid Grid.Row="1" Margin="0,30,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding PositionText}" FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center" MinWidth="48" />

                <!--
                  进度条：外观走上面自备的 PlayerSliderStyle（已播放段为蓝色）。
                  单击跳转不走 XAML 事件，原因见 MainWindow.xaml.cs 里的
                  OnSeekMouseLeftButtonDown：必须赶在引擎旧位置回包覆盖之前提交，
                  而且要绕过 Slider 自己对该事件的 Handled 标记。
                -->
                <Slider x:Name="SeekSlider" Grid.Column="1" Margin="12,0,12,0"
                        Style="{StaticResource PlayerSliderStyle}"
                        Minimum="0"
                        Maximum="{Binding DurationSeconds}"
                        Value="{Binding PositionSeconds, Mode=TwoWay}"
                        IsEnabled="{Binding HasMedia}"
                        IsMoveToPointEnabled="True"
                        Cursor="Hand"
                        PreviewKeyUp="OnSeekKeyUp"
                        Thumb.DragStarted="OnSeekDragStarted"
                        Thumb.DragCompleted="OnSeekDragCompleted" />

                <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center" MinWidth="48"
                           TextAlignment="Right" />
            </Grid>

            <!-- 传输控制与音量 -->
            <Grid Grid.Row="2" Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="打开文件"
                               Icon="{ui:SymbolIcon FolderOpen24}"
                               Command="{Binding OpenFileCommand}"
                               ToolTip="打开音频文件 (Ctrl+O)" />

                    <Button Style="{StaticResource TransportButton}" Margin="14,0,0,0"
                            Command="{Binding StopCommand}"
                            IsEnabled="{Binding HasMedia}"
                            ToolTip="停止 (Ctrl+S)">
                        <ui:SymbolIcon Symbol="Stop24" FontSize="14" />
                    </Button>
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource PrimaryTransportButton}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Command="{Binding TogglePlayPauseCommand}"
                        IsEnabled="{Binding HasMedia}"
                        ToolTip="{Binding PlayPauseHint}">
                    <!--
                      图标交给 ViewModel 决定：这里不能再用「本地 Text 值 + 样式触发器」，
                      因为本地值的优先级高于触发器，触发器永远不生效，图标会恒定不变。
                    -->
                    <ui:SymbolIcon Symbol="{Binding PlayPauseSymbol}" FontSize="22" />
                </Button>

                <!--
                  静音键与音量滑块合为一组：喇叭图标既显示当前状态、又是静音开关，
                  滑块紧随其后调节音量。

                  与进度条同款外观（已到达一段为蓝色），同样开启单击定位。
                  音量走的是 OnVolumeChanged 直接写回引擎，不需要额外提交，
                  因此这里不需要事件处理器。
                -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource TransportButton}"
                            Command="{Binding ToggleMuteCommand}"
                            ToolTip="{Binding VolumeText}">
                        <ui:SymbolIcon Symbol="{Binding VolumeSymbol}" FontSize="16" />
                    </Button>

                    <Slider Width="130" Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource PlayerSliderStyle}"
                            Minimum="0" Maximum="100"
                            Value="{Binding Volume, Mode=TwoWay}"
                            IsMoveToPointEnabled="True"
                            Cursor="Hand"
                            ToolTip="{Binding VolumeText}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
