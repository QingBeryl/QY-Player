<Window x:Class="QYPlayer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QYPlayer.App"
        mc:Ignorable="d"
        Title="QY Player"
        Height="560" Width="900"
        MinHeight="480" MinWidth="720"
        Background="#FF14161A"
        Foreground="#FFE8EAED"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        AllowDrop="True"
        Loaded="OnWindowLoaded"
        DragOver="OnWindowDragOver"
        Drop="OnWindowDrop">

    <!--
      M1 阶段的界面只覆盖「单文件播放」这一条主线：
      打开文件、元数据展示、播放控制、进度与音量。
      曲库列表、播放队列、歌词在 M2 / M2.5 再补，避免过早把布局写死。
    -->

    <Window.Resources>

        <!-- 滑块主体：左侧已播放部分高亮，右侧用半透明白表示剩余部分。 -->
        <Style x:Key="SliderRepeatButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderRepeatButtonFilled" TargetType="RepeatButton"
               BasedOn="{StaticResource SliderRepeatButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="#FF4C8DFF" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderRepeatButtonTrack" TargetType="RepeatButton"
               BasedOn="{StaticResource SliderRepeatButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="#33FFFFFF" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          滑块本体。Track 会自动按 Value 排布两段 RepeatButton 与 Thumb，
          因此不需要手动绑定填充宽度。
        -->
        <Style x:Key="PlayerSlider" TargetType="Slider">
            <Setter Property="Height" Value="18" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Style="{StaticResource SliderRepeatButtonFilled}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Style="{StaticResource SliderRepeatButtonTrack}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="SeekThumb" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14" Fill="#FFFFFFFF" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 传输控制按钮：圆形底盘 + 悬停/按下反馈。 -->
        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="#FFE8EAED" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Plate" Fill="#1AFFFFFF" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Fill" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Plate" Property="Fill" Value="#4CFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主播放键：实心强调色，视觉上作为整个界面的焦点。 -->
        <Style x:Key="PrimaryTransportButton" TargetType="Button" BasedOn="{StaticResource TransportButton}">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Foreground" Value="#FF0B0D10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Plate" Fill="#FF4C8DFF" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Fill" Value="#FF6AA2FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Plate" Property="Fill" Value="#FF3A78E0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 文字按钮，用于「打开文件」。 -->
        <Style x:Key="FlatTextButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFE8EAED" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate" CornerRadius="6" Background="#1AFFFFFF"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="#4CFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Window.InputBindings>
        <!-- 空格切换播放/暂停，Ctrl+O 打开文件，符合桌面播放器的既有习惯。 -->
        <KeyBinding Key="Space" Command="{Binding TogglePlayPauseCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding StopCommand}" />
        <KeyBinding Key="M" Modifiers="Control" Command="{Binding ToggleMuteCommand}" />
    </Window.InputBindings>

    <Grid Margin="28,22,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：应用名与当前状态 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="QY Player" FontSize="15" FontWeight="SemiBold" Foreground="#FFB9C0CC" />
                <TextBlock Text="清玉播放器" FontSize="13" Margin="10,0,0,0"
                           Foreground="#FF6E7683" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12"
                       Foreground="#FF8A929E" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="360" />
        </Grid>

        <!-- 中部：封面 + 曲目信息 -->
        <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,26,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
              封面容器。未提取到封面时底层的音符占位图形会透出来，
              因此不需要额外的可见性切换逻辑。
            -->
            <Border Grid.Column="0" Width="180" Height="180" CornerRadius="10"
                    Background="#FF1D2026" ClipToBounds="True">
                <Grid>
                    <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="46"
                               Foreground="#FF3A4049"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding CurrentTrack.CoverCachePath}" Stretch="UniformToFill" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Margin="26,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold"
                           Foreground="#FFF5F7FA" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Artist}" FontSize="16" Margin="0,10,0,0"
                           Foreground="#FFB9C0CC" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Album}" FontSize="13" Margin="0,6,0,0"
                           Foreground="#FF6E7683" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding FormatText}" FontSize="12" Margin="0,14,0,0"
                           Foreground="#FF5D646F" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- 进度条与时间 -->
        <Grid Grid.Row="2" Margin="0,30,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding PositionText}" FontSize="12"
                       Foreground="#FF8A929E" VerticalAlignment="Center" MinWidth="48" />

            <Slider x:Name="SeekSlider" Grid.Column="1" Margin="12,0,12,0"
                    Style="{StaticResource PlayerSlider}"
                    Minimum="0"
                    Maximum="{Binding DurationSeconds}"
                    Value="{Binding PositionSeconds, Mode=TwoWay}"
                    IsEnabled="{Binding HasMedia}"
                    Thumb.DragStarted="OnSeekDragStarted"
                    Thumb.DragCompleted="OnSeekDragCompleted" />

            <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="12"
                       Foreground="#FF8A929E" VerticalAlignment="Center" MinWidth="48"
                       TextAlignment="Right" />
        </Grid>

        <!-- 传输控制与音量 -->
        <Grid Grid.Row="3" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource FlatTextButton}"
                        Content="打开文件"
                        Command="{Binding OpenFileCommand}"
                        ToolTip="打开音频文件 (Ctrl+O)" />

                <Button Style="{StaticResource TransportButton}" Margin="14,0,0,0"
                        Command="{Binding StopCommand}"
                        IsEnabled="{Binding HasMedia}"
                        ToolTip="停止 (Ctrl+S)">
                    <TextBlock Text="&#x25A0;" FontSize="14" />
                </Button>
            </StackPanel>

            <Button Grid.Column="1" Style="{StaticResource PrimaryTransportButton}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Command="{Binding TogglePlayPauseCommand}"
                    IsEnabled="{Binding HasMedia}"
                    ToolTip="{Binding PlayPauseHint}">
                <!--
                  图标交给 ViewModel 决定：这里不能再用「本地 Text 值 + 样式触发器」，
                  因为本地值的优先级高于触发器，触发器永远不生效，图标会恒定不变。
                -->
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="22"
                           Text="{Binding PlayPauseGlyph}" />
            </Button>

            <!--
              静音键与音量滑块合为一组：喇叭图标既显示当前状态、又是静音开关，
              滑块紧随其后调节音量。旧版本拆成两个隔开的控件，
              图标既不变、位置又和音量无关，看起来像两个不相关的按钮。
            -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource TransportButton}"
                        Command="{Binding ToggleMuteCommand}"
                        ToolTip="{Binding VolumeText}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Text="{Binding VolumeGlyph}" />
                </Button>

                <Slider Width="130" Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource PlayerSlider}"
                        Minimum="0" Maximum="100"
                        Value="{Binding Volume, Mode=TwoWay}"
                        ToolTip="{Binding VolumeText}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
