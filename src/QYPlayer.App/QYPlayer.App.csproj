<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>QYPlayer.App</RootNamespace>

    <!-- 产物名不带 App 后缀，用户看到的是 QYPlayer.exe。 -->
    <AssemblyName>QYPlayer</AssemblyName>

    <!--
      libVLC 原生库只有 x64 版本，程序必须按 x64 生成；
      RuntimeIdentifier 同时决定 VideoLAN.LibVLC.Windows 把原生库复制到
      libvlc\win-x64 的布局，因此这里必须显式指定。
    -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>

    <!--
      应用图标与 Windows 资源属性。图标由 build\make-icon.py 从品牌源图
      （Assets\logo.jpg）派生，同时作用于 exe、任务栏、开始菜单快捷方式与安装程序。
      注意 ApplicationIcon 走的是 Win32 资源通道，与下面 ItemGroup 里的 Resource
      是两回事：前者给外壳看，后者给界面里的 WPF 控件看。
    -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>QY Player</AssemblyTitle>
    <Description>清玉播放器 —— 支持本地音乐播放与加密格式插件扩展的桌面播放器</Description>
  </PropertyGroup>

  <ItemGroup>
    <!--
      标题栏左侧的品牌标记（MainWindow.xaml 的 TitleBar.Icon）。
      必须显式声明为 Resource：.NET SDK 的默认通配只把非代码文件收成 None，
      而 None 既不会嵌进程序集、也不会带上 pack:// 资源地址，
      XAML 里写 pack://application:,,,/Assets/app-logo.png 就会在运行期解码失败。
      同时把它从 None 里摘掉，免得同一个文件挂在两种项类型上。
    -->
    <Resource Include="Assets\app-logo.png" />
    <None Remove="Assets\app-logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <!--
      Fluent 风格的控件、主题与窗口材质。选它而不是手写控件模板，
      原因见 REQUIREMENTS.md 的 8.3：深色/浅色主题、沉浸式标题栏、
      Mica 材质与标题栏配色同步都是它已经解决的问题。
    -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QYPlayer.Core\QYPlayer.Core.csproj" />
    <ProjectReference Include="..\QYPlayer.Audio\QYPlayer.Audio.csproj" />
    <ProjectReference Include="..\QYPlayer.Metadata\QYPlayer.Metadata.csproj" />
    <ProjectReference Include="..\QYPlayer.Data\QYPlayer.Data.csproj" />
  </ItemGroup>

</Project>
